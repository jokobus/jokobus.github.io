[vaultwarden-short]
# if 3 tries in 3 minutes fail -> banned for 5 minutes
enabled = true
port = 80,443,8081
filter = vaultwarden
banaction = %(banaction_allports)s
# banaction = iptables # if fail2ban already uses nftables, but docker still iptables (uncomment line and comment line above)
logpath = /vwdata/vaultwarden.log
maxretry = 2
bantime = 300
findtime = 180
chain = FORWARD
