[nextcloud-short]
# if 3 tries in 3 minutes fail -> banned for 5 minutes
# See: https://github.com/nextcloud/all-in-one/?tab=readme-ov-file#fail2ban
# And: https://docs.nextcloud.com/server/stable/admin_manual/installation/harden_server.html#setup-fail2ban
chain=DOCKER-USER
backend = auto
enabled = true
port = 80,443,8080,8443,3478
protocol = tcp
filter = nextcloud
maxretry = 2
bantime = 300
findtime = 180
logpath = /mnt/nextcloud_logs/data/nextcloud.log