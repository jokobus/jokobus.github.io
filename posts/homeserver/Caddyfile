	reverse_proxy immich_server:2283 {
		header_up X-Real-IP {client_ip}
	}
}

https://homebox.example.com:443 {
    log {
        level INFO
        output file {$LOG_FILE} {
            roll_size 10MB
            roll_keep 10
        }
    }

    # Apply your refined security headers
    import security_header

    # Proxy to the Homebox container on its internal port (7745)
    reverse_proxy homebox:7745 {
        header_up X-Real-IP {client_ip}
    }
}

example.com {
	# Refined security
	import security_header
	header {
	    # Updated CSP to allow KaTeX fonts/styles and Pyodide WASM execution
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; img-src 'self' data:; connect-src 'self' https://cdn.jsdelivr.net https://pypi.org https://files.pythonhosted.org; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none';"
		# Protect user privacy by stripping sensitive URL path data when navigating away from your site.
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	# Point Caddy to your automatically updated Hugo directory
	root * /var/www/example.com
	# Enable standard file serving for static HTML/CSS/JS
	file_server
	# Optional: Enable Gzip/Zstd compression for faster page loads
	encode zstd gzip
}
